# Normaliza fim de linha: LF no repositório, sempre.
# Garante que scripts .sh e o Dockerfile funcionem dentro do container Linux
# independente do editor no Windows.
* text=auto eol=lf

*.py   text eol=lf
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.md   text eol=lf
Dockerfile text eol=lf

*.png binary
*.jpg binary
*.ico binary