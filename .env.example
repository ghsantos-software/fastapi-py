# Nome da aplicação — aparece no título do /docs. Opcional.
APP_NAME=api-tarefas

# Credenciais do Postgres. O Docker Compose usa isto para:
#  - criar o container do banco
#  - montar a DATABASE_URL da aplicação
POSTGRES_USER=tarefas
POSTGRES_PASSWORD=tarefas
POSTGRES_DB=tarefas

# Sem Docker: NÃO defina DATABASE_URL. A aplicação cai num
# arquivo SQLite local (tarefas.db) e você roda "uvicorn main:app".